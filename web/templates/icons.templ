package templates

// OS Distribution Icons - Clean, minimal SVGs for dark backgrounds
templ IconUbuntu() {
	<svg viewBox="0 0 24 24" fill="currentColor" class="field-icon">
		<circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.5"/>
		<circle cx="12" cy="5" r="2.5" fill="currentColor"/>
		<circle cx="5.5" cy="15.5" r="2.5" fill="currentColor"/>
		<circle cx="18.5" cy="15.5" r="2.5" fill="currentColor"/>
		<circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.5"/>
	</svg>
}

